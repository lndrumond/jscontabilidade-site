# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db
desktop.ini

# editores e configuração local da IDE
.vscode/
.idea/

# configuração local do Claude Code (permissões pessoais)
.claude/settings.local.json

# arquivo original pesado do favicon (9,8 MB, não usado pelos scripts)
/design/favicon-original.ico

# capturas de página salvas durante testes locais
/scripts/localhost_*.html

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Exemplo de variáveis, sem valores reais: versionar
!.env.local.example
/CLAUDEINFO.md
